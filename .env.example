# Copy this file to .env and replace the placeholders on this machine.
# .env is ignored by git and blocked from web access.
# Existing process, user, or system environment variables take precedence over .env.

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your-gmail-address@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM_ADDRESS=your-gmail-address@gmail.com
MAIL_FROM_NAME=CMMP Church Portal

# After these values are real Gmail SMTP credentials, CMMP emails each user's
# account address for registration, request confirmation, assignments, and status updates.

# Optional overrides. Leave these commented for local XAMPP
# (MySQL on 127.0.0.1 or localhost, database cmmp_db, user root, empty password).
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=cmmp_db
# DB_USER=root
# DB_PASSWORD=
# APP_TIMEZONE=Asia/Manila
